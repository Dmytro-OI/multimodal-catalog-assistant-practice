PORT=3100
NODE_ENV=development
PUBLIC_BASE_URL=https://your-service.onrender.com

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_IMAGE_BUCKET=images

TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret
ADMIN_TELEGRAM_IDS=123456789

GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash
GEMINI_VISION_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

MATCH_THRESHOLD=0.42
RECOMMENDATION_MATCH_THRESHOLD=0.28
MATCH_COUNT=5
IMAGE_MATCH_THRESHOLD=0.35
IMAGE_MATCH_CANDIDATES=5
ENRICHMENT_BATCH_SIZE=5
ENRICHMENT_PAGE_SIZE=100
ENRICHMENT_DELAY_MS=5000
ENRICHMENT_MAX_RETRIES=3
ENRICHMENT_RETRY_BASE_DELAY_MS=5000
ENRICHMENT_RETRY_MAX_DELAY_MS=60000
IMAGE_INDEX_BATCH_SIZE=900
IMAGE_INDEX_DELAY_MS=1000
IMAGE_INDEX_CONCURRENCY=3
